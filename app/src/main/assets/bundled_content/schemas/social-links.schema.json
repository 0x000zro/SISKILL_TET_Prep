{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedagogy.local/schemas/social-links.schema.json",
  "title": "CommunitySocialLinks",
  "type": "object",
  "required": [
    "channels"
  ],
  "additionalProperties": false,
  "properties": {
    "support_email": {
      "type": "string",
      "format": "email"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "platform",
          "url",
          "is_official"
        ],
        "additionalProperties": false,
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "Telegram",
              "YouTube",
              "WhatsApp",
              "GitHub",
              "X_Twitter",
              "Website"
            ]
          },
          "handle_name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "is_official": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
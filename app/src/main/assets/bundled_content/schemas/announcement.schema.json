{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedagogy.local/schemas/announcement.schema.json",
  "title": "SystemAnnouncement",
  "type": "object",
  "required": [
    "id",
    "title",
    "message",
    "priority",
    "published_at_utc"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "urgent",
        "normal",
        "info"
      ]
    },
    "action_url": {
      "type": "string",
      "format": "uri"
    },
    "published_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  }
}
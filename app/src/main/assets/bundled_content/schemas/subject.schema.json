{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedagogy.local/schemas/subject.schema.json",
  "title": "SubjectManifest",
  "type": "object",
  "required": [
    "subject_id",
    "name_en",
    "name_hi",
    "total_topics",
    "leaf_assets",
    "topics"
  ],
  "additionalProperties": false,
  "properties": {
    "subject_id": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "name_hi": {
      "type": "string"
    },
    "total_topics": {
      "type": "integer",
      "minimum": 1
    },
    "leaf_assets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Concept",
          "Short_Notes",
          "PYQ",
          "MCQ",
          "Practice"
        ]
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "topic.schema.json"
      }
    }
  }
}
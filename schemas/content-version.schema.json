{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedagogy.local/schemas/content-version.schema.json",
  "title": "ContentVersion",
  "type": "object",
  "required": [
    "schema_version",
    "content_bundle_version",
    "updated_at_utc",
    "checksum_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "content_bundle_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "checksum_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "min_app_version_supported": {
      "type": "string"
    },
    "delta_sync_enabled": {
      "type": "boolean"
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
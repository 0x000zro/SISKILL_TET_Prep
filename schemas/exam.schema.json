{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedagogy.local/schemas/exam.schema.json",
  "title": "ExamDefinition",
  "type": "object",
  "required": [
    "exam_code",
    "title_en",
    "title_hi",
    "conducting_body",
    "applicable_papers"
  ],
  "additionalProperties": false,
  "properties": {
    "exam_code": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "title_en": {
      "type": "string"
    },
    "title_hi": {
      "type": "string"
    },
    "conducting_body": {
      "type": "string"
    },
    "validity_years": {
      "type": "string",
      "enum": [
        "Lifetime",
        "7_Years",
        "Other"
      ]
    },
    "negative_marking": {
      "type": "boolean"
    },
    "applicable_papers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}